{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rd-harness/schemas/daily-report.schema.json",
  "title": "Daily Report",
  "description": "日报上报数据结构 JSON Schema，覆盖 git/kanban/ai/blockers 全部字段。Go 消费端可据此生成 struct。",
  "type": "object",
  "required": ["date", "git_username", "repo", "git", "kanban", "branch"],
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "日报日期，CST 时区，格式 YYYY-MM-DD"
    },
    "git_username": {
      "type": "string",
      "minLength": 1,
      "description": "Git 用户名"
    },
    "repo": {
      "type": "string",
      "minLength": 1,
      "description": "当前仓库名（basename）"
    },
    "git": { "$ref": "#/$defs/GitSection" },
    "branch": { "type": "string", "minLength": 1, "description": "Git 分支名" },
    "kanban": { "$ref": "#/$defs/KanbanSection" },
    "ai": {
      "description": "AI 效能数据，由 collect-ai.js 采集，可选",
      "$ref": "#/$defs/AISection"
    },
    "blockers": {
      "type": "array",
      "description": "手填卡点列表，可选",
      "items": { "$ref": "#/$defs/BlockerEntry" }
    }
  },

  "$defs": {
    "GitSection": {
      "type": "object",
      "required": ["stats", "classification", "tags", "commits"],
      "additionalProperties": false,
      "properties": {
        "stats": { "$ref": "#/$defs/GitStats" },
        "classification": { "$ref": "#/$defs/Classification" },
        "tags": { "$ref": "#/$defs/Tags" },
        "commits": {
          "type": "array",
          "items": { "$ref": "#/$defs/Commit" }
        }
      }
    },

    "GitStats": {
      "type": "object",
      "required": ["commits", "files_changed", "insertions", "deletions"],
      "additionalProperties": false,
      "properties": {
        "commits": { "type": "integer", "minimum": 0 },
        "files_changed": { "type": "integer", "minimum": 0 },
        "insertions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 }
      }
    },

    "Classification": {
      "type": "object",
      "required": ["ai_independent", "ai_collaborative", "human"],
      "additionalProperties": false,
      "properties": {
        "ai_independent": { "$ref": "#/$defs/ClassificationBucket" },
        "ai_collaborative": { "$ref": "#/$defs/ClassificationBucket" },
        "human": { "$ref": "#/$defs/ClassificationBucket" }
      }
    },

    "ClassificationBucket": {
      "type": "object",
      "required": ["count", "hashes"],
      "additionalProperties": false,
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "hashes": {
          "type": "array",
          "items": { "type": "string", "minLength": 8, "maxLength": 8 }
        }
      }
    },

    "Tags": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/TagEntry" }
      },
      "description": "标签分组，key 为标签名，value 为该标签下的提交摘要列表"
    },

    "TagEntry": {
      "type": "object",
      "required": ["hash", "title"],
      "additionalProperties": false,
      "properties": {
        "hash": { "type": "string", "minLength": 8, "maxLength": 8 },
        "title": { "type": "string" }
      }
    },

    "Commit": {
      "type": "object",
      "required": [
        "hash", "full_hash", "datetime", "author",
        "subject", "body", "operator_type", "operator_detail",
        "stage", "module"
      ],
      "additionalProperties": false,
      "properties": {
        "hash": {
          "type": "string",
          "minLength": 8, "maxLength": 8,
          "description": "短 hash（8 位）"
        },
        "full_hash": {
          "type": "string",
          "minLength": 40, "maxLength": 40,
          "description": "完整 SHA1 hash（40 位）"
        },
        "datetime": {
          "type": "string",
          "description": "Git 提交时间，格式如 '2026-06-04 15:48:45 +0800'"
        },
        "author": { "type": "string", "minLength": 1 },
        "subject": { "type": "string" },
        "body": { "type": "string" },
        "operator_type": {
          "type": "string",
          "enum": ["ai_independent", "ai_collaborative", "human"],
          "description": "操作者分类：AI 独立/AI 协作/人工"
        },
        "operator_detail": {
          "type": "string",
          "description": "操作者详细标识，如 'AI-wangzk.Developer' 或空字符串"
        },
        "stage": {
          "type": "string",
          "description": "提交阶段标识: DEV/BUG/CM/TEST/DOCS/REFACTOR"
        },
        "module": {
          "type": "string",
          "description": "模块名（从 commit subject 中提取）"
        }
      }
    },

    "KanbanSection": {
      "type": "object",
      "required": ["source_file", "user", "tasks", "stats", "deadline_calendar"],
      "additionalProperties": false,
      "properties": {
        "source_file": { "type": "string" },
        "user": {
          "oneOf": [
            { "$ref": "#/$defs/KanbanUser" },
            { "type": "null" }
          ],
          "description": "看板用户信息，无目标用户时为 null"
        },
        "tasks": {
          "type": "array",
          "items": { "$ref": "https://rd-harness/schemas/kanban-task.schema.json" }
        },
        "stats": { "$ref": "https://rd-harness/schemas/kanban-source.schema.json#/$defs/KanbanStats" },
        "deadline_calendar": { "$ref": "https://rd-harness/schemas/kanban-source.schema.json#/$defs/DeadlineCalendar" }
      }
    },

    "KanbanUser": {
      "type": "object",
      "required": ["git_username", "group"],
      "additionalProperties": false,
      "properties": {
        "git_username": { "type": "string", "minLength": 1 },
        "group": { "type": "string" }
      }
    },

    "AISection": {
      "type": "object",
      "required": ["date", "tasks", "summary"],
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string", "format": "date" },
        "harness_version": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ],
          "description": "Harness 框架版本号，未安装时为 null"
        },
        "client_name": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ],
          "description": "AI 客户端标识，如 'claude-code'、'codex'、'cursor'、'cline'，未识别时为 null"
        },
        "client_version": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ],
          "description": "AI 客户端版本号，未识别时为 null"
        },
        "tasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/AITask" }
        },
        "summary": { "$ref": "#/$defs/AISummary" }
      }
    },

    "AITask": {
      "type": "object",
      "required": ["change_name", "caller", "title", "current_phase", "phases_completed", "phases_total", "scores", "quality_metrics", "dispatches"],
      "additionalProperties": false,
      "properties": {
        "change_name": {
          "type": "string", "minLength": 1,
          "description": "变更目录名"
        },
        "caller": {
          "type": "string",
          "description": "调度发起人（git_username），空串表示无 caller"
        },
        "title": {
          "type": "string", "minLength": 1,
          "description": "任务标题"
        },
        "current_phase": {
          "type": "string",
          "description": "当前阶段"
        },
        "phases_completed": {
          "type": "integer", "minimum": 0,
          "description": "已完成阶段数"
        },
        "phases_total": {
          "type": "integer", "minimum": 1,
          "description": "总阶段数"
        },
        "scores": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "integer", "minimum": 0, "maximum": 100 },
              { "type": "null" }
            ]
          },
          "description": "各角色评审得分，key 为角色名，value 为 0-100 整数或 null"
        },
        "quality_metrics": { "$ref": "#/$defs/QualityMetrics" },
        "dispatches": {
          "type": "array",
          "items": { "$ref": "#/$defs/Dispatch" }
        },
        "_usage_source": {
          "type": "boolean",
          "description": "内部标记：标识此任务条目来自 usage.jsonl 而非 pipeline-state.json"
        }
      }
    },

    "QualityMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "first_pass_rate": {
          "type": "number", "minimum": 0, "maximum": 1,
          "description": "首次通过率（0-1）"
        },
        "total_rework_loops": {
          "type": "integer", "minimum": 0,
          "description": "总返工次数"
        },
        "total_wall_clock_ms": {
          "type": "integer", "minimum": 0,
          "description": "总耗时（毫秒）"
        },
        "phases_completed": {
          "type": "integer", "minimum": 0,
          "description": "已完成阶段数"
        },
        "phases_total": {
          "type": "integer", "minimum": 1,
          "description": "总阶段数"
        },
        "automated_catches": {
          "type": "integer", "minimum": 0,
          "description": "AI 自动发现的缺陷数"
        },
        "time_to_first_code_review_ms": {
          "type": "integer", "minimum": 0,
          "description": "首次代码审查耗时（毫秒）"
        }
      },
      "description": "质量指标，可能为空对象 {}"
    },

    "Dispatch": {
      "type": "object",
      "required": ["phase", "started_at", "completed_at", "token_usage", "exit_status"],
      "additionalProperties": false,
      "properties": {
        "phase": {
          "type": "string", "minLength": 1,
          "description": "调度所属阶段，如 'explore'、'implement'、'usage-natural' 等"
        },
        "started_at": {
          "type": "string",
          "description": "开始时间，ISO 8601 格式"
        },
        "completed_at": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ],
          "description": "完成时间，ISO 8601 格式，未完成时为 null"
        },
        "token_usage": {
          "oneOf": [
            { "$ref": "#/$defs/TokenUsage" },
            { "type": "null" }
          ],
          "description": "Token 用量，无数据时为 null"
        },
        "exit_status": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ],
          "description": "退出状态：DONE/DONE_WITH_CONCERNS/BLOCKED/NEEDS_CONTEXT，或 null"
        }
      }
    },

    "TokenUsage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens", "model"],
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_input_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_input_tokens": { "type": "integer", "minimum": 0 },
        "model": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ],
          "description": "模型名称，如 'claude-sonnet-4-6'、'glm-5.1'，无数据时为 null"
        },
        "backend": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ],
          "description": "本次 dispatch 使用的 backend（claude/codex/codebuddy/qoder/zcode），由 mark-dispatch --backend 写入；缺失时按当前客户端估算"
        },
        "total": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ],
          "description": "Codex 路径：单值 total token（来自 --tokens N）；Claude 路径不写此字段"
        }
      }
    },

    "AISummary": {
      "type": "object",
      "required": [
        "total_input_tokens", "total_output_tokens", "total_dispatches",
        "total_wall_clock_ms", "dispatch_by_trigger", "spec_stats",
        "concern_stats", "session_input_tokens", "session_output_tokens",
        "session_cache_creation_input_tokens", "session_cache_read_input_tokens",
        "session_count", "session_by_project", "session_by_model"
      ],
      "additionalProperties": false,
      "properties": {
        "total_input_tokens": { "type": "integer", "minimum": 0 },
        "total_output_tokens": { "type": "integer", "minimum": 0 },
        "total_dispatches": { "type": "integer", "minimum": 0 },
        "total_wall_clock_ms": { "type": "integer", "minimum": 0 },
        "dispatch_by_trigger": { "$ref": "#/$defs/DispatchByTrigger" },
        "by_backend": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/BackendBucket" },
          "description": "按 backend 分组聚合 token，不跨 backend 求和。Key 为 backend 名（claude/codex/codebuddy/qoder/zcode/unknown）"
        },
        "backend_fallback_count": {
          "type": "integer", "minimum": 0,
          "description": "无 backend 字段的 dispatch 条目数（向前兼容旧 state，按当前客户端兜底）"
        },
        "spec_stats": { "$ref": "#/$defs/SpecStats" },
        "concern_stats": { "$ref": "#/$defs/ConcernStats" },
        "session_input_tokens": { "type": "integer", "minimum": 0 },
        "session_output_tokens": { "type": "integer", "minimum": 0 },
        "session_cache_creation_input_tokens": { "type": "integer", "minimum": 0 },
        "session_cache_read_input_tokens": { "type": "integer", "minimum": 0 },
        "session_count": { "type": "integer", "minimum": 0 },
        "session_total_tokens": { "type": "integer", "minimum": 0 },
        "session_reasoning_tokens": { "type": "integer", "minimum": 0 },
        "session_by_project": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/SessionByProjectEntry" },
          "description": "按看板的会话统计，key 为看板简称"
        },
        "session_by_model": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/SessionByModelEntry" },
          "description": "按模型的 Token 统计，key 为模型名"
        },
        "sampled_gap_count": {
          "type": "integer",
          "minimum": 0,
          "description": "采样缺口计数：usage.jsonl 中 tokens:null 的短命 subagent 记录数"
        }
      }
    },

    "BackendBucket": {
      "type": "object",
      "required": ["dispatch_count", "input_tokens", "output_tokens", "cached_tokens", "reasoning_tokens", "total_tokens", "model"],
      "additionalProperties": false,
      "description": "按 backend 分组的 token 聚合；null 字段表示该 backend 下不可用（如 ZCode 未公开稳定 token schema）",
      "properties": {
        "dispatch_count": { "type": "integer", "minimum": 0 },
        "input_tokens": {
          "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }],
          "description": "input tokens（Claude 写入；Codex 为 null）"
        },
        "output_tokens": {
          "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }],
          "description": "output tokens（Claude 写入；Codex 为 null）"
        },
        "cached_tokens": {
          "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }],
          "description": "cached tokens（Claude: cache_read；Codex 为 null）"
        },
        "reasoning_tokens": {
          "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }],
          "description": "reasoning tokens（Codex reasoning_output 待 ZDR；当前两 backend 均为 null）"
        },
        "total_tokens": {
          "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }],
          "description": "total tokens（Codex 单值；Claude 为 null）"
        },
        "model": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }],
          "description": "dominant 模型名；Codex 为 null"
        }
      }
    },

    "DispatchByTrigger": {
      "type": "object",
      "required": ["pipeline", "natural"],
      "additionalProperties": false,
      "properties": {
        "pipeline": { "$ref": "#/$defs/TriggerBucket" },
        "natural": { "$ref": "#/$defs/TriggerBucket" },
        "main": { "$ref": "#/$defs/TriggerBucket" }
      }
    },

    "TriggerBucket": {
      "type": "object",
      "required": ["dispatch_count", "input_tokens", "output_tokens", "cache_read_tokens", "by_role", "by_model"],
      "additionalProperties": false,
      "properties": {
        "dispatch_count": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_tokens": {
          "type": "integer", "minimum": 0,
          "description": "Cache 创建 token 数（可选，历史数据可能缺失，消费端按 0 兜底）"
        },
        "by_role": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/RoleTokenBucket" },
          "description": "按角色分组的 Token 统计，key 为角色名（architect/developer/tester/reviewer）"
        },
        "by_model": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/ModelTokenBucket" },
          "description": "按模型分组的 Token 统计，key 为模型名"
        }
      }
    },

    "RoleTokenBucket": {
      "type": "object",
      "required": ["dispatch_count", "input_tokens", "output_tokens", "cache_read_tokens"],
      "additionalProperties": false,
      "properties": {
        "dispatch_count": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_tokens": {
          "type": "integer", "minimum": 0,
          "description": "Cache 创建 token 数（可选，历史数据可能缺失，消费端按 0 兜底）"
        }
      }
    },

    "ModelTokenBucket": {
      "type": "object",
      "required": ["dispatch_count", "input_tokens", "output_tokens", "cache_read_tokens"],
      "additionalProperties": false,
      "properties": {
        "dispatch_count": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_tokens": {
          "type": "integer", "minimum": 0,
          "description": "Cache 创建 token 数（可选，历史数据可能缺失，消费端按 0 兜底）"
        }
      }
    },

    "SpecStats": {
      "type": "object",
      "required": ["total_changes", "closed_loop", "open", "by_phase"],
      "additionalProperties": false,
      "properties": {
        "total_changes": { "type": "integer", "minimum": 0 },
        "closed_loop": { "type": "integer", "minimum": 0 },
        "open": { "type": "integer", "minimum": 0 },
        "by_phase": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 },
          "description": "按阶段分布统计，key 为阶段名，value 为变更数"
        }
      }
    },

    "ConcernStats": {
      "type": "object",
      "required": ["total", "p0_found", "p0_closed", "p1_found", "p1_closed"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "p0_found": { "type": "integer", "minimum": 0 },
        "p0_closed": { "type": "integer", "minimum": 0 },
        "p1_found": { "type": "integer", "minimum": 0 },
        "p1_closed": { "type": "integer", "minimum": 0 },
        "p2_found": { "type": "integer", "minimum": 0 },
        "p2_closed": { "type": "integer", "minimum": 0 },
        "missing_author_skipped": {
          "type": "integer", "minimum": 0,
          "description": "Issue !278：缺 author 字段未计入统计的 concerns 条数（老数据无此字段，可选）"
        },
        "details": {
          "type": "array",
          "items": { "$ref": "#/$defs/ConcernDetail" },
          "description": "未关闭 P0/P1/P2 明细（落实到人）：change/author/severity/description"
        }
      }
    },

    "ConcernDetail": {
      "type": "object",
      "required": ["change", "author", "severity"],
      "additionalProperties": false,
      "properties": {
        "change": { "type": "string" },
        "author": { "type": "string" },
        "severity": { "type": "string", "enum": ["P0", "P1", "P2"] },
        "description": { "type": "string" }
      }
    },

    "SessionByProjectEntry": {
      "type": "object",
      "required": ["slug", "count", "input_tokens", "output_tokens", "cache_read_tokens", "cache_creation_tokens"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_tokens": { "type": "integer", "minimum": 0 },
        "model": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "total_tokens": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "reasoning_tokens": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
      }
    },

    "SessionByModelEntry": {
      "type": "object",
      "required": ["count", "input_tokens", "output_tokens", "cache_read_tokens", "cache_creation_tokens"],
      "additionalProperties": false,
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_tokens": { "type": "integer", "minimum": 0 },
        "model": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "total_tokens": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "reasoning_tokens": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
      }
    },

    "BlockerEntry": {
      "type": "object",
      "required": ["category", "description"],
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string",

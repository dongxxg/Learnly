# ============================================================
# rd_harness 分发模板（注入业务仓库的版本）
# 框架安装产物，业务仓库不应提交
# ============================================================
# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node
node_modules/
.npm
.eslintcache
.stylelintcache
*.tsbuildinfo
.nyc_output/
coverage/

# Python
__pycache__/
*.pyc

# 环境变量
.env
.env.local
.env.test
.env.prod
.gitlab-config
.gitlab-config.d/

# outputs
outputs/


# FUSE 临时文件
.fuse_hidden*


/.settings/
/.project
/.pydevproject


# 框架目录（setup-harness.sh 安装产物；忽略所有常见 AI agent 框架目录）
.claude/
.codex/
.codex-plugin/
.codebuddy/
.codebuddy-plugin/
.qoder/
.qoder-plugin/
.zcode/
.zcode-plugin/
.trae/
.cursor/
.windsurf/
.aider/
.cline/
.roo/
.gemini/
.github-copilot/
.composer/
.cody/
.continue/
.devin/

# MCP 本地配置（含访问 token，禁止提交）
.mcp.json

# setup 诊断日志（含 npm 错误等运行时信息）
.harness/.setup-*.log
.harness/.worktrees/
# daily-report 多仓库采集配置（collect-all.js 生成，含本机绝对路径，机器本地）
.harness-projects

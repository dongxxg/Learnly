# ===== 知芽 Learnly 环境变量示例 =====
# cp .env.example .env 后按实际填写；.env 已被 .gitignore 忽略，勿提交真实密钥

# ----- PostgreSQL -----
LEARNLY_POSTGRES_HOST=postgres
LEARNLY_POSTGRES_PORT=5432
LEARNLY_POSTGRES_USER=learnly
LEARNLY_POSTGRES_PASSWORD=learnly
LEARNLY_POSTGRES_DBNAME=learnly
LEARNLY_POSTGRES_SSLMODE=disable

# ----- Redis -----
LEARNLY_REDIS_HOST=redis
LEARNLY_REDIS_PORT=6379
LEARNLY_REDIS_PASSWORD=
LEARNLY_REDIS_DB=0

# ----- Backend -----
LEARNLY_SERVER_PORT=8080
LEARNLY_SERVER_MODE=release
LEARNLY_AI_BASEURL=http://ai-service:8000
LEARNLY_JWT_SECRET=please-change-me
LEARNLY_JWT_EXPIRE_HOURS=24

# ----- AI Service -----
LEARNLY_AI_LLM_PROVIDER=openai
LEARNLY_AI_LLM_API_KEY=
LEARNLY_AI_LLM_BASE_URL=https://api.openai.com/v1
LEARNLY_AI_LLM_MODEL=gpt-4o-mini
LEARNLY_AI_REDIS_URL=redis://redis:6379/1
LEARNLY_AI_MCP_ENABLED=false

# ----- Frontend（H5 浏览器侧，仅开发直连时需要）-----
VITE_API_BASE_URL=

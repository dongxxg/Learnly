# ===== 知芽 Learnly 环境变量示例 =====
# cp .env.example .env 后按实际填写；.env 已被 .gitignore 忽略，勿提交真实密钥

# ----- PostgreSQL -----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=learnly
POSTGRES_PASSWORD=learnly
POSTGRES_DBNAME=learnly
POSTGRES_SSLMODE=disable

# ----- Redis -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ----- Backend -----
SERVER_PORT=8080
SERVER_MODE=release
AI_BASEURL=http://ai-service:8000
JWT_SECRET=please-change-me
JWT_EXPIRE_HOURS=24

# ----- AI Service -----
LEARNLY_AI_LLM_PROVIDER=openai
LEARNLY_AI_LLM_API_KEY=
LEARNLY_AI_LLM_BASE_URL=https://api.openai.com/v1
LEARNLY_AI_LLM_MODEL=gpt-4o-mini
LEARNLY_AI_REDIS_URL=redis://redis:6379/1
LEARNLY_AI_MCP_ENABLED=false

# ----- Frontend（H5 浏览器侧，仅开发直连时需要）-----
VITE_API_BASE_URL=

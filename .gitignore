.venv/
venv/
env/
*.egg-info/
*.whl
# 前端构建输出
dist/
build/
.vite/
.tmp/

.zcode/
.zcode-plugin/
# ===== 框架 vendored 模式：框架文件入库，仅忽略凭证/依赖/临时态 =====
.claude/skills/daily-report/scripts/node_modules/
.claude/settings.local.json
.harness/.push-challenge
.harness/.push-approved
.harness/.framework-edit

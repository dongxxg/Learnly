.cody/
.continue/
.devin/

# MCP 本地配置（含访问 token，禁止提交）
.mcp.json

.codegraph

# ===== 业务构建产物 =====
# Go
*.exe
*.exe~
backend/server
backend/cmd/server/server
*.test

# ============================================================
# rd_harness 分发模板（注入业务仓库的版本）
# 框架安装产物，业务仓库不应提交
# ============================================================
# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node
node_modules/
.npm
.eslintcache
.stylelintcache
*.tsbuildinfo
.nyc_output/
coverage/

# Python
__pycache__/
*.pyc

# 环境变量
.env
.env.local
.env.test
.env.prod
.gitlab-config
.gitlab-config.d/

# outputs
outputs/


# FUSE 临时文件
.fuse_hidden*


/.settings/
/.project
/.pydevproject

.codex/
.codex-plugin/
